# PulsePass Environment Configuration
NODE_ENV=development
PORT=3000
FRONTEND_PORT=5173

# Database (PostgreSQL 16)
DATABASE_URL=postgres://pulsepass:pulsepass_secret@localhost:5432/pulsepass_master
DB_HOST=localhost
DB_PORT=5432
DB_USER=pulsepass
DB_PASSWORD=pulsepass_secret
DB_NAME=pulsepass_master

# Cache & Distributed Locks (Redis 7)
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# Event Broker (Apache Kafka KRaft)
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=pulsepass-service
KAFKA_GROUP_ID=pulsepass-workers

# Security & Secrets
JWT_SECRET=pulsepass_super_secret_jwt_key_2026_production_grade
HMAC_TICKET_SECRET=pulsepass_hmac_secret_sha256_access_token_secure_key
